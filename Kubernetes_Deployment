Step 1: Create Amazon EKS Cluster

# Prerequisites

Install and configure:

* AWS CLI
* eksctl
* kubectl

# Configure AWS credentials:

aws configure

# Create EKS Cluster

eksctl create cluster \
--name=otel-observability \
--region=ap-south-1 \
--zones=ap-south-1a,ap-south-1b \
--without-nodegroup

# Associate IAM OIDC Provider

eksctl utils associate-iam-oidc-provider \
--region ap-south-1 \
--cluster otel-observability \
--approve

# Create Managed Node Group

eksctl create nodegroup \
--cluster=otel-observability \
--region=ap-south-1 \
--name=otel-observability-ng-private \
--node-type=t3.medium \
--nodes-min=2 \
--nodes-max=3 \
--node-volume-size=20 \
--managed \
--asg-access \
--external-dns-access \
--full-ecr-access \
--appmesh-access \
--alb-ingress-access \
--node-private-networking

# Verify Cluster:
kubectl get nodes

Step 2: Clone Repository

git clone https://github.com/anujakanase/opentelemetry-demo.git

cd opentelemetry-demo

Step 3: Install OpenTelemetry Demo using Helm

# Add OpenTelemetry Helm Repository

helm repo add open-telemetry https://open-telemetry.github.io/opentelemetry-helm-charts

helm repo update

# Deploy OpenTelemetry Demo

helm install my-otel-demo open-telemetry/opentelemetry-demo

# Step 4: Generate Kubernetes Manifests

helm template opentelemetry-demo open-telemetry/opentelemetry-demo \
--namespace otel-demo > opentelemetry-demo.yaml

# Apply the generated manifests:

kubectl apply -f opentelemetry-demo.yaml

Verify Pods:
kubectl get pods

Verify Services:
kubectl get svc

# Step 5: Access the Application

# Expose the frontend using port forwarding:

kubectl --namespace default port-forward svc/frontend-proxy 8080:8080

🌐 Application URLs

# OpenTelemetry Demo Store

http://localhost:8080/

# Grafana Dashboard

http://localhost:8080/grafana/

# Load Generator UI

http://localhost:8080/loadgen/

# Jaeger UI

http://localhost:8080/jaeger/ui/

# Feature Flag Configurator

http://localhost:8080/feature

# 🧹 Cleanup

Delete the EKS Cluster:

eksctl delete cluster --name otel-observability



